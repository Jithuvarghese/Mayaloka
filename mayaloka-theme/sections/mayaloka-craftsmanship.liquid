{% liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign intro = section.settings.intro
  assign section_id = 'mayaloka-craft-' | append: section.id
%}

<section class="mayaloka-craft">
  <div class="mayaloka-craft__wrap">
    <div class="mayaloka-craft__head">
      {% if eyebrow != blank %}
        <span class="mayaloka-label">{{ eyebrow }}</span>
      {% endif %}
      {% if heading != blank %}
        <h2>{{ heading }}</h2>
      {% endif %}
      {% if intro != blank %}
        <p class="mayaloka-craft__intro">{{ intro }}</p>
      {% endif %}
    </div>

    <div class="mayaloka-craft__carousel" id="{{ section_id }}">
      <button
        type="button"
        class="mayaloka-craft__nav mayaloka-craft__nav--prev"
        aria-label="Previous"
        data-craft-prev
      >&#8249;</button>

      <div class="mayaloka-craft__track" data-craft-track>
        {% for block in section.blocks %}
          <div class="mayaloka-craft__card" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <div class="mayaloka-craft__icon">{{ block.settings.icon }}</div>
            {% endif %}
            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p>{{ block.settings.description }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <button
        type="button"
        class="mayaloka-craft__nav mayaloka-craft__nav--next"
        aria-label="Next"
        data-craft-next
      >&#8250;</button>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById({{ section_id | json }});
    if (!root) return;
    var track = root.querySelector('[data-craft-track]');
    var prev = root.querySelector('[data-craft-prev]');
    var next = root.querySelector('[data-craft-next]');

    function scrollByCard(dir) {
      var card = track.querySelector('.mayaloka-craft__card');
      if (!card) return;
      var amount = card.getBoundingClientRect().width + 20;
      track.scrollBy({ left: dir * amount, behavior: 'smooth' });
    }

    if (prev) prev.addEventListener('click', function () { scrollByCard(-1); });
    if (next) next.addEventListener('click', function () { scrollByCard(1); });
  })();
</script>

{% stylesheet %}
  .mayaloka-craft {
    padding: 90px 0;
    background: var(--mayaloka-paper);
  }

  .mayaloka-craft__wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .mayaloka-craft__head {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 50px;
  }

  .mayaloka-craft__head .mayaloka-label {
    display: block;
    margin-bottom: 14px;
  }

  .mayaloka-craft__head h2 {
    font-family: var(--mayaloka-font-display);
    font-weight: 600;
    font-size: clamp(28px, 3.6vw, 40px);
    color: var(--mayaloka-maroon);
    margin: 0 0 18px;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .mayaloka-craft__intro {
    color: var(--mayaloka-ink-soft);
    font-size: 15.5px;
    line-height: 1.7;
    margin: 0;
  }

  .mayaloka-craft__carousel {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .mayaloka-craft__track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 4px;
    flex: 1;
  }

  .mayaloka-craft__track::-webkit-scrollbar {
    display: none;
  }

  .mayaloka-craft__card {
    flex: 0 0 auto;
    width: 240px;
    scroll-snap-align: start;
    background: var(--mayaloka-cream-light);
    border: 1px solid rgba(36, 30, 25, .1);
    padding: 32px 24px;
    text-align: center;
  }

  .mayaloka-craft__icon {
    font-size: 28px;
    margin-bottom: 16px;
  }

  .mayaloka-craft__card h3 {
    font-family: var(--mayaloka-font-label);
    font-size: 14px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--mayaloka-maroon);
    margin: 0 0 12px;
  }

  .mayaloka-craft__card p {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--mayaloka-ink-soft);
    margin: 0;
  }

  .mayaloka-craft__nav {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--mayaloka-maroon);
    background: var(--mayaloka-cream-light);
    color: var(--mayaloka-maroon);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background .2s, color .2s;
  }

  .mayaloka-craft__nav:hover {
    background: var(--mayaloka-maroon);
    color: var(--mayaloka-cream-light);
  }

  @media screen and (max-width: 600px) {
    .mayaloka-craft__card {
      width: 200px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mayaloka Craftsmanship",
  "tag": "section",
  "class": "mayaloka-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "The Mayaloka Standard"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What makes our craftsmanship premium?"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro paragraph",
      "default": "Mayaloka is known for its unbeatable fine craftsmanship. From hand-finished settings to anti-tarnish plating, every piece is made with the finest materials and thoughtful design — offering not just jewellery, but a premium experience."
    }
  ],
  "blocks": [
    {
      "type": "craft_card",
      "name": "Craftsmanship card",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "✦" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mayaloka Craftsmanship",
      "blocks": [
        {
          "type": "craft_card",
          "settings": {
            "icon": "♥",
            "title": "Handmade with Love",
            "description": "Each piece is meticulously handcrafted with love and attention to detail, ensuring uniqueness and superior quality in every style."
          }
        },
        {
          "type": "craft_card",
          "settings": {
            "icon": "✦",
            "title": "Detailed Design",
            "description": "Our pieces feature intricate designs that highlight exquisite craftsmanship — a blend of traditional artistry and modern aesthetics."
          }
        },
        {
          "type": "craft_card",
          "settings": {
            "icon": "◈",
            "title": "Anti-Tarnish Plating",
            "description": "Our jewellery is lavishly coated in premium anti-tarnish plating, providing a rich, luxurious finish that ensures lasting shine."
          }
        },
        {
          "type": "craft_card",
          "settings": {
            "icon": "❖",
            "title": "Hypoallergenic",
            "description": "Thoughtfully designed to be gentle on your skin — pieces are hypoallergenic, offering all-day comfort without irritation."
          }
        },
        {
          "type": "craft_card",
          "settings": {
            "icon": "⬥",
            "title": "High-Quality Raw Material",
            "description": "We use only the finest raw materials, ensuring every piece is durable, resilient, and retains its beauty over time."
          }
        }
      ]
    }
  ]
}
{% endschema %}
