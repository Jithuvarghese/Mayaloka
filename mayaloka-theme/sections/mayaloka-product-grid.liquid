{% liquid
  assign label = section.settings.label
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
%}

<section class="mayaloka-shop">
  <div class="mayaloka-shop__wrap">
    <div class="mayaloka-sec-head">
      {% if label != blank %}
        <span class="mayaloka-label">{{ label }}</span>
      {% endif %}
      {% if heading != blank %}
        <h2>{{ heading }}</h2>
      {% endif %}
      {% if subtext != blank %}
        <p>{{ subtext }}</p>
      {% endif %}
    </div>

    <div class="mayaloka-shop__grid">
      {% if collection != blank and collection.products.size > 0 %}
        {% for product in collection.products limit: products_to_show %}
          <a href="{{ product.url }}" class="mayaloka-p-card">
            <div class="mayaloka-p-card__img">
              {% if product.featured_image != blank %}
                {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'mayaloka-p-card__photo' }}
              {% endif %}
              {% if product.available == false %}
                <span class="mayaloka-p-tag">Sold out</span>
              {% endif %}
              <div class="mayaloka-p-card__quick">Quick Add</div>
            </div>
            <div class="mayaloka-p-card__info">
              <h3>{{ product.title }}</h3>
              <div class="mayaloka-p-card__price">
                {% if product.compare_at_price > product.price %}
                  <s>{{ product.compare_at_price | money }}</s>{{ product.price | money }}
                {% else %}
                  {{ product.price | money }}
                {% endif %}
              </div>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% for block in section.blocks %}
          {% liquid
            assign swatch_index = forloop.index0 | modulo: 8 | plus: 1
          %}
          <a
            href="{{ routes.all_products_collection_url }}"
            class="mayaloka-p-card mayaloka-p-card--s{{ swatch_index }}"
            {{ block.shopify_attributes }}
          >
            <div class="mayaloka-p-card__img">
              <div class="mayaloka-p-card__ph"></div>
              {% if block.settings.tag != blank %}
                <span class="mayaloka-p-tag">{{ block.settings.tag }}</span>
              {% endif %}
            </div>
            <div class="mayaloka-p-card__info">
              <h3>{{ block.settings.title }}</h3>
              <div class="mayaloka-p-card__price">
                {% if block.settings.compare_price != blank %}
                  <s>{{ block.settings.compare_price }}</s>{{ block.settings.price }}
                {% else %}
                  {{ block.settings.price }}
                {% endif %}
              </div>
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .mayaloka-shop {
    padding: 100px 0;
    background: var(--mayaloka-cream-light);
  }

  .mayaloka-shop__wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .mayaloka-shop__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 26px 22px;
  }

  .mayaloka-p-card {
    display: block;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
  }

  .mayaloka-p-card__img {
    aspect-ratio: 1 / 1.15;
    position: relative;
    overflow: hidden;
    margin-bottom: 14px;
  }

  .mayaloka-p-card__ph,
  .mayaloka-p-card__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mayaloka-p-card__ph { background: linear-gradient(155deg, var(--mayaloka-gold-soft), var(--mayaloka-maroon) 75%); }
  .mayaloka-p-card--s2 .mayaloka-p-card__ph { background: linear-gradient(155deg, #3a6479, #17384a 75%); }
  .mayaloka-p-card--s3 .mayaloka-p-card__ph { background: linear-gradient(155deg, #c98a4a, #7e2a20 75%); }
  .mayaloka-p-card--s4 .mayaloka-p-card__ph { background: linear-gradient(155deg, #d9b675, #5d2c22 75%); }
  .mayaloka-p-card--s5 .mayaloka-p-card__ph { background: linear-gradient(155deg, #8f4b3a, #0f262f 75%); }
  .mayaloka-p-card--s6 .mayaloka-p-card__ph { background: linear-gradient(155deg, #b58a4a, #a6392c 75%); }
  .mayaloka-p-card--s7 .mayaloka-p-card__ph { background: linear-gradient(155deg, #3a6479, #7e2a20 75%); }
  .mayaloka-p-card--s8 .mayaloka-p-card__ph { background: linear-gradient(155deg, #d9b675, #17384a 75%); }

  .mayaloka-p-card__quick {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(23, 56, 74, .92);
    color: var(--mayaloka-cream);
    text-align: center;
    padding: 12px;
    font-family: var(--mayaloka-font-body);
    font-size: 11.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    font-weight: 600;
    transform: translateY(100%);
    transition: transform .3s ease;
  }

  .mayaloka-p-card:hover .mayaloka-p-card__quick {
    transform: translateY(0);
  }

  .mayaloka-p-tag {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--mayaloka-cream-light);
    color: var(--mayaloka-maroon);
    font-size: 10px;
    letter-spacing: .08em;
    padding: 4px 8px;
    font-family: var(--mayaloka-font-label);
    text-transform: uppercase;
  }

  .mayaloka-p-card__info h3 {
    font-family: var(--mayaloka-font-body);
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 4px;
    color: var(--mayaloka-ink);
  }

  .mayaloka-p-card__price {
    font-family: var(--mayaloka-font-body);
    font-size: 14px;
    color: var(--mayaloka-maroon);
    font-weight: 600;
  }

  .mayaloka-p-card__price s {
    color: var(--mayaloka-ink-soft);
    font-weight: 400;
    margin-right: 6px;
  }

  @media screen and (max-width: 960px) {
    .mayaloka-shop__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mayaloka Product Grid",
  "tag": "section",
  "class": "mayaloka-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Treasure Finds"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New This Season"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Handpicked, anti-tarnish, made to stay in rotation."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection (leave empty to use placeholder cards below)"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "placeholder_product",
      "name": "Placeholder product",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Kintsugi Hoop Earrings" },
        { "type": "text", "id": "price", "label": "Price", "default": "₹1,450" },
        { "type": "text", "id": "compare_price", "label": "Compare-at price (optional)" },
        { "type": "text", "id": "tag", "label": "Tag (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mayaloka Product Grid",
      "blocks": [
        { "type": "placeholder_product", "settings": { "title": "Kintsugi Hoop Earrings", "price": "₹1,450", "tag": "New" } },
        { "type": "placeholder_product", "settings": { "title": "Bazaar Layered Necklace", "price": "₹2,100", "compare_price": "₹2,600", "tag": "Bestseller" } },
        { "type": "placeholder_product", "settings": { "title": "Meena Stack Ring", "price": "₹980", "tag": "Antique" } },
        { "type": "placeholder_product", "settings": { "title": "Nostalgia Charm Bracelet", "price": "₹1,750" } },
        { "type": "placeholder_product", "settings": { "title": "Old Bazaar Choker", "price": "₹3,200", "tag": "Limited" } },
        { "type": "placeholder_product", "settings": { "title": "Signet Stamp Ring", "price": "₹1,150" } },
        { "type": "placeholder_product", "settings": { "title": "Fading Signboard Studs", "price": "₹890", "tag": "New" } },
        { "type": "placeholder_product", "settings": { "title": "Treasure Trove Anklet", "price": "₹1,320" } }
      ]
    }
  ]
}
{% endschema %}
