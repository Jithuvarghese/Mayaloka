{% liquid
  assign label = section.settings.label
  assign heading = section.settings.heading
  assign paragraph_1 = section.settings.paragraph_1
  assign paragraph_2 = section.settings.paragraph_2
  assign signature = section.settings.signature
%}

<section class="mayaloka-story" id="mayaloka-story">
  <div class="mayaloka-story__wrap">
    <div class="mayaloka-story__collage">
      <div class="mayaloka-story__tile mayaloka-story__tile--a"></div>
      <div class="mayaloka-story__tile mayaloka-story__tile--b"></div>
      <div class="mayaloka-story__tile mayaloka-story__tile--c"></div>
    </div>
    <div class="mayaloka-story__text">
      {% if label != blank %}
        <span class="mayaloka-label">{{ label }}</span>
      {% endif %}
      {% if heading != blank %}
        <h2>{{ heading }}</h2>
      {% endif %}
      {% if paragraph_1 != blank %}
        <p>{{ paragraph_1 }}</p>
      {% endif %}
      {% if paragraph_2 != blank %}
        <p>{{ paragraph_2 }}</p>
      {% endif %}
      {% if signature != blank %}
        <div class="mayaloka-story__signature">{{ signature }}</div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .mayaloka-story {
    padding: 100px 0;
    background: var(--mayaloka-cream-light);
  }

  .mayaloka-story__wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .mayaloka-story__collage {
    position: relative;
    aspect-ratio: 1 / 1;
  }

  .mayaloka-story__tile {
    position: absolute;
    border: 1px solid rgba(36, 30, 25, .15);
    box-shadow: 0 14px 30px rgba(23, 56, 74, .15);
  }

  .mayaloka-story__tile--a {
    width: 62%;
    height: 62%;
    top: 0;
    left: 0;
    background: linear-gradient(135deg, #8f4b3a, #5d2c22);
    z-index: 2;
  }

  .mayaloka-story__tile--b {
    width: 48%;
    height: 48%;
    bottom: 0;
    right: 0;
    background: linear-gradient(135deg, #1c4258, #0f262f);
    z-index: 1;
  }

  .mayaloka-story__tile--c {
    width: 34%;
    height: 34%;
    top: 26%;
    left: 52%;
    background: radial-gradient(circle at 40% 30%, #d9b675, #a6392c 70%);
    z-index: 3;
    border-radius: 50%;
  }

  .mayaloka-story__text h2 {
    font-family: var(--mayaloka-font-display);
    font-weight: 600;
    font-size: clamp(30px, 3.6vw, 42px);
    margin: 14px 0 22px;
    line-height: 1.12;
    color: var(--mayaloka-ink);
  }

  .mayaloka-story__text p {
    color: var(--mayaloka-ink-soft);
    margin: 0 0 16px;
    font-size: 15.5px;
    max-width: 460px;
  }

  .mayaloka-story__signature {
    font-family: var(--mayaloka-font-display);
    font-style: italic;
    font-size: 19px;
    color: var(--mayaloka-maroon);
    margin-top: 22px;
  }

  @media screen and (max-width: 960px) {
    .mayaloka-story__wrap {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mayaloka Story",
  "tag": "section",
  "class": "mayaloka-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "What is Mayaloka"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A curated world, not just a jewellery box."
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "Mayaloka is a curated jewellery brand that blends modern design with the nostalgia of old Indian shopping experiences — the fading signboards, the weathered arches, the bazaars that carry stories within them."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "Every product, package, and interaction is designed to feel less like a transaction and more like discovering a small treasure worth keeping."
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature line",
      "default": "— This isn't just a necklace. This is a Mayaloka piece."
    }
  ],
  "presets": [
    {
      "name": "Mayaloka Story"
    }
  ]
}
{% endschema %}
